[Desktop Entry]
Type=Service
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/x-ms-shortcut;application/x-executable;application/vnd.microsoft.portable-executable;
Actions=addToSteam
X-KDE-Priority=TopLevel

[Desktop Action addToSteam]
Name=Add to Steam (Proton ARM64)
Icon=steam
Exec=/var/home/armada/.local/bin/add-to-steam %F
