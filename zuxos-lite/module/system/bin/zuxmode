#!/system/bin/sh
# zuxmode [performance|balanced|battery|next|status]
F=/data/adb/zuxos_lite_mode; cur=$(cat $F 2>/dev/null || echo balanced)
m=${1:-status}
[ "$m" = next ] && case $cur in balanced) m=performance;; performance) m=battery;; *) m=balanced;; esac
[ "$m" = status ] && { echo "$cur"; exit 0; }
setcl() { # policy maxpercent minpercent
  P=/sys/devices/system/cpu/cpufreq/policy$1; [ -d $P ] || return
  max=$(cat $P/cpuinfo_max_freq); min=$(cat $P/cpuinfo_min_freq)
  echo $(( max * $2 / 100 )) > $P/scaling_max_freq 2>/dev/null
  echo $(( min + (max - min) * $3 / 100 )) > $P/scaling_min_freq 2>/dev/null
}
G=/sys/class/kgsl/kgsl-3d0
case $m in
 performance) for p in 0 2 5 7; do setcl $p 100 45; done; echo 1 > $G/force_clk_on 2>/dev/null; echo 0 > $G/idle_timer 2>/dev/null; echo 3 > $G/min_pwrlevel 2>/dev/null ;;
 battery)     setcl 0 100 0; setcl 2 70 0; setcl 5 65 0; setcl 7 55 0; echo 0 > $G/force_clk_on 2>/dev/null; echo 80 > $G/idle_timer 2>/dev/null; echo $(( $(cat $G/num_pwrlevels 2>/dev/null || 1) - 1 )) > $G/min_pwrlevel 2>/dev/null ;;
 *)           m=balanced; for p in 0 2 5 7; do setcl $p 100 0; done; echo 0 > $G/force_clk_on 2>/dev/null; echo 80 > $G/idle_timer 2>/dev/null; echo $(( $(cat $G/num_pwrlevels 2>/dev/null || 1) - 1 )) > $G/min_pwrlevel 2>/dev/null ;;
esac
echo $m > $F
su -lp 2000 -c "cmd notification post -S bigtext -t 'ZUXOS Lite' zuxmode 'Mode: $m'" >/dev/null 2>&1
echo "$m"
